{
	"name": "trader-journal-plugin",
	"version": "1.3.1",
	"description": "Trading journal for Obsidian with backtest and live trade workflows.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node validate-bundle.mjs",
		"test": "node scripts/run-tests.mjs",
		"benchmark": "node scripts/run-benchmark.mjs",
		"validate": "node validate-manifest.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"react": "18.3.1",
		"react-dom": "18.3.1"
	}
}
